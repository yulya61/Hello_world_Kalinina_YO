   "source": [
    "N = int(input(\"Введите число N: \"))\n",
    "\n",
    "factor = 1\n",
    "\n",
    "for i in range(1, N):\n",
    "    factor = factor * i\n",
    "\n",
    "print(\"Факториал числа:\", factor)\n"
   ]
